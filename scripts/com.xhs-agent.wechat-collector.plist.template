<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.xhs-agent.wechat-collector</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PROJECT_DIR__/scripts/start-wechat-collector.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/data/wechat-collector.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/data/wechat-collector.err.log</string>
</dict>
</plist>
